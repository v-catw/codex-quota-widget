# Track the Rust release sources and their build inputs.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/Cargo.toml
!/Cargo.lock
!/src/
/src/*
!/src/*.rs
!/src/widget/
**/target/
!/installer/
/installer/*
!/installer/CodexQuotaWidget-Rust.iss
!/installer/Languages/
/installer/Languages/*
!/installer/Languages/ChineseSimplified.isl
!/assets/
/assets/*
!/assets/codex-quota-logo.ico
!/assets/mascot/
/assets/mascot/*
!/assets/mascot/gpt-dragon/
/assets/mascot/gpt-dragon/*
!/assets/mascot/gpt-dragon/layers-v2/
/assets/mascot/gpt-dragon/layers-v2/*
!/assets/mascot/gpt-dragon/layers-v2/body-idle.png
!/assets/mascot/gpt-dragon/layers-v2/body-happy.png
!/assets/mascot/gpt-dragon/layers-v2/wing-left.png
!/testdata/
/testdata/*
!/testdata/usage-success.json
!/testdata/usage-empty-window.json
!/testdata/usage-invalid.json
auth.json
.env
.env.*
*.exe
*.pdb
